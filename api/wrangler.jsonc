{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sabado-a-tarde-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // Only reachable through the frontend Worker's service binding: the browser
  // talks to /api/* on the site's own origin, so no CORS and first-party cookies.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "COOKIE_SECURE": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sabado-a-tarde",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sabado-a-tarde-media"
    }
  ]
}
