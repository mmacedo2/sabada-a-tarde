{
  "name": "sabado-a-tarde-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/initial-data.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file seed/initial-data.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.13.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260930.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
